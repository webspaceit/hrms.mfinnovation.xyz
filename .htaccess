# ============================================================
# Rent Management System - Apache configuration
# ============================================================

# IMPORTANT: disable Apache content-negotiation. With MultiViews on,
# a request for /invoices is auto-mapped to a file or directory of
# that name and the front controller is bypassed.
Options -MultiViews

# ------------------------------------------------------------
# Pretty URLs: /flats, /tenant-payments, ... -> index.php?r=...
# Only rewrites paths that are not real files or directories, so
# assets/, ajax/*.php, file.php and cron/*.php keep working.
# ------------------------------------------------------------
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_/-]+)/?$ index.php?r=$1 [L,QSA]

# ------------------------------------------------------------
# Block direct web access to internals.
#
# These two sections apply to this directory AND every subdirectory, so
# they keep working when the app lives in a sub-folder (/rms/).
#
# PHP files in app/, classes/ and lang/ are only ever included, never
# requested; the SQL dumps, the error log and dotfiles must never be
# downloadable. config/ and logs/ additionally carry their own .htaccess
# so they stay protected even if this file fails to upload (some FTP
# clients hide dotfiles).
#
# cron/ is intentionally reachable over HTTP: cron/invoices.php is
# token-guarded and is the documented fallback for hosts without CLI.
#
# Requires AllowOverride to permit these directives. On a host with
# AllowOverride None they are ignored and the app still works - ask
# support if you want them enforced.
# ------------------------------------------------------------

<FilesMatch "\.(sql|md|log|ini|json|lock|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Dotfiles (.env, .git, editor swap files, ...) - never served.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# No directory listings anywhere in the app.
Options -Indexes
