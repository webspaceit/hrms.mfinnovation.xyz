# IMPORTANT: disable Apache content-negotiation. With MultiViews on,
# a request for /invoices is auto-mapped to the existing invoices.php
# (Vary: negotiate) and bypasses the front controller, so converted
# routes would silently keep serving the legacy files.
Options -MultiViews

RewriteEngine On

# Pretty URLs: /flats, /tenant-payments, ... -> index.php?r=...
# Only rewrites paths that are not real files or directories, so
# assets/, ajax/*.php and (during migration) legacy pages keep working.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_/-]+)/?$ index.php?r=$1 [L,QSA]