RewriteEngine On

# Pretty URLs: /flats, /tenant-payments, ... -> index.php?r=...
# Only rewrites paths that are not real files or directories, so
# assets/, ajax/*.php and (during migration) legacy pages keep working.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9_/-]+)/?$ index.php?r=$1 [L,QSA]